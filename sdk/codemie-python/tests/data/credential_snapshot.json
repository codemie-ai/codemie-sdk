{
  "source": {
    "captured": "2026-11-27",
    "key_set_origin": "tool configuration classes"
  },
  "type_name_map": {
    "OPEN_API": "OPENAPI",
    "FILE_SYSTEM": "FILESYSTEM",
    "SERVICENOW": "SERVICE_NOW",
    "ENVIRONMENT_VARS": "MCP"
  },
  "types": {
    "A2A": {
      "selects": {
        "auth_type": {
          "options": ["apikey", "basic", "bearer", "aws_signature"],
          "origin": "ui"
        }
      }
    },
    "AWS": {
      "keys": ["region", "access_key_id", "secret_access_key", "session_token"]
    },
    "Azure": {
      "keys": ["subscription_id", "tenant_id", "client_id", "client_secret"]
    },
    "AzureDevOps": {
      "keys": ["url", "token", "organization_url", "project", "limit", "organization", "api_version"]
    },
    "Confluence": {
      "keys": ["url", "username", "token", "cloud", "auth_type"]
    },
    "Elastic": {
      "keys": ["url", "api_key"]
    },
    "Email": {
      "keys": ["url", "auth_type", "smtp_username", "smtp_password", "oauth_from_email", "oauth_client_id", "oauth_client_secret", "oauth_tenant_id", "oauth_authority", "oauth_scope"],
      "selects": {
        "auth_type": {
          "options": ["basic", "oauth_azure"],
          "origin": "backend"
        }
      }
    },
    "GCP": {
      "keys": ["service_account_key"]
    },
    "Git": {
      "keys": ["auth_type", "url", "token", "app_id", "private_key", "installation_id"],
      "selects": {
        "auth_type": {
          "options": ["pat", "github_app"],
          "origin": "backend"
        }
      }
    },
    "Jira": {
      "keys": ["url", "username", "token", "cloud", "auth_type"]
    },
    "Keycloak": {
      "keys": ["base_url", "realm", "client_id", "client_secret", "timeout"]
    },
    "Kubernetes": {
      "keys": ["url", "token", "verify_ssl"]
    },
    "MSExchange": {
      "keys": ["auth_type", "mailbox", "ews_url", "service_account_username", "service_account_password", "oauth_tenant_id", "oauth_client_id", "oauth_client_secret"],
      "selects": {
        "auth_type": {
          "options": ["oauth_azure", "ntlm"],
          "origin": "backend"
        }
      }
    },
    "OpenAPI": {
      "keys": ["spec", "is_basic_auth", "username", "api_key", "timeout", "auth_header_name"]
    },
    "ReportPortal": {
      "keys": ["url", "api_key", "project"]
    },
    "SQL": {
      "keys": ["dialect", "host", "port", "username", "password", "database_name", "token", "org", "bucket", "verify_ssl"],
      "selects": {
        "dialect": {
          "options": ["mysql", "postgres", "influxdb", "mssql"],
          "origin": "backend"
        }
      }
    },
    "Scheduler": {
      "selects": {
        "resource_type": {
          "options": ["assistant", "workflow", "datasource"],
          "origin": "ui"
        }
      }
    },
    "ServiceNow": {
      "keys": ["url", "api_key"]
    },
    "SharePoint": {
      "keys": ["url", "auth_type", "tenant_id", "client_id", "client_secret"],
      "selects": {
        "auth_type": {
          "options": ["app", "oauth"],
          "origin": "backend"
        }
      }
    },
    "Sonar": {
      "keys": ["url", "token", "sonar_project_name"]
    },
    "Telegram": {
      "keys": ["bot_token"]
    },
    "Webhook": {
      "selects": {
        "gitlab_event_filter": {
          "options": ["open", "update", "close", "reopen", "merge", "approved,unapproved"],
          "origin": "ui"
        },
        "resource_type": {
          "options": ["assistant", "workflow", "datasource"],
          "origin": "ui"
        }
      }
    },
    "XWiki": {
      "keys": ["url", "username", "token", "use_bearer"]
    },
    "Xray": {
      "keys": ["base_url", "client_id", "client_secret", "limit", "verify_ssl", "timeout"]
    },
    "ZephyrScale": {
      "keys": ["url", "token"]
    }
  }
}
