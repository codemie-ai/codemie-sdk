{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.prod*)",
      "Read(/**/.env.dev*)",
      "Read(/**/.env.stag*)",
      "Read(/**/.env.uat*)",
      "Read(/**/.env.qa*)",
      "Read(/**/.env.test*)",
      "Read(/**/*.env)",
      "Read(/**/.envrc)",
      "Read(/**/.env.e2e)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.*.local)",
      "Edit(/**/.env.prod*)",
      "Edit(/**/.env.dev*)",
      "Edit(/**/.env.stag*)",
      "Edit(/**/.env.uat*)",
      "Edit(/**/.env.qa*)",
      "Edit(/**/.env.test*)",
      "Edit(/**/*.env)",
      "Edit(/**/.envrc)",
      "Edit(/**/.env.e2e)",
      "Read(/**/.npmrc)",
      "Read(/**/.pypirc)",
      "Edit(/**/.npmrc)",
      "Edit(/**/.pypirc)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Edit(/**/*.pem)",
      "Edit(/**/*.key)",
      "Edit(/**/*.p12)",
      "Edit(/**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(/**/poetry.lock)",
      "Edit(/**/package-lock.json)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(* --no-verify*)",
      "Bash(poetry publish*)",
      "Bash(make publish*)",
      "Bash(npm publish*)",
      "Bash(npm dist-tag *)",
      "Bash(twine upload*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push * refs/tags/*)",
      "Bash(git push * python-v*)",
      "Bash(git push * node-v*)"
    ],
    "ask": [
      "Bash(git push *--force-with-lease*)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -R *)",
      "Bash(gh workflow run publish*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh release edit*)",
      "Edit(.github/workflows/**)",
      "Edit(.gitleaks.toml)",
      "Edit(.claude/settings.json)"
    ]
  }
}
