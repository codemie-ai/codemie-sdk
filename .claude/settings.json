{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.e2e)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.e2e)",
      "Edit(**/.env.development)",
      "Edit(**/.env.test)",
      "Edit(**/.env.production)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.*.local)",
      "Write(**/.env.e2e)",
      "Write(**/.env.development)",
      "Write(**/.env.test)",
      "Write(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(**/poetry.lock)",
      "Write(**/poetry.lock)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -xf*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git commit*--no-verify*)",
      "Bash(* --no-verify*)",
      "Bash(poetry publish*)",
      "Bash(make publish*)",
      "Bash(npm publish*)",
      "Bash(npm dist-tag *)",
      "Bash(twine upload*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push * refs/tags/*)",
      "Bash(git push * python-v*)",
      "Bash(git push * node-v*)",
      "Bash(gh workflow run publish-*)"
    ],
    "ask": [
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh release edit*)"
    ]
  }
}
